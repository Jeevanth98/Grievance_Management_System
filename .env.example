# Supabase Project Configuration
# Replace with your actual Supabase Project URL and Anon/Publishable Key
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Supabase Service Role Key (Used strictly for server-side admin provisioning if enabled)
# Never expose this key in client-side code or browser bundles!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application Settings
APP_NAME="Grievance Management System - Admin Portal"
APP_ENV="development"
DEBUG="True"
